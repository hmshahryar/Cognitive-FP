ENVIRONMENT=development
FRONTEND_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
CLERK_SECRET_KEY=
COMPOSIO_API_KEY=
# Optional. Leave empty: the app creates its own limited HubSpot config automatically.
HUBSPOT_AUTH_CONFIG_ID=
# >= 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
APPROVAL_SIGNING_KEY=
# AI employees
GOOGLE_API_KEY=
# Optional failover keys. Use a different Google project for each: limits are per project.
# Add GOOGLE_API_KEY3, GOOGLE_API_KEY4, ... the same way.
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
LLM_MODEL=gemini-4-hydrogen
# composio (keyless, default) or gemini (Google Search grounding; needs Gemini billing)
SEARCH_PROVIDER=composio
