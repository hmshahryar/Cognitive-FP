# ============================================================
# Cognitive Mesh — root .gitignore (covers visual/ and logic/)
# ============================================================

# ---------- Secrets / environment ----------
# Never commit real keys. Only *.example templates are tracked.
.env
.env.*
!.env.example
*.pem
*.key

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ---------- Frontend: visual/ (Next.js) ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
coverage/
.vercel
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Locally installed agent skills (restorable from visual/skills-lock.json)
.agents/

# ---------- Backend: logic/ (Python / uv) ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local SQLite databases (dev data, LangGraph checkpoints)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
logic/data/

# ---------- Logs ----------
*.log
logs/
